    "date": "2026-11-11",
    "author": "Yawol Khongthang Kangleipak ",
    "category": "Philosophy",
    "thumbnail_url": "https://raw.githubusercontent.com/Arnold-cd/blog-cms/main/images/sllk-photo-hd-200kb.jpg",
